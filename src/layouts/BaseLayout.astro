---
interface Props {
  title: string;
  description?: string;
}

import "../styles/global.css";

const {
  title,
  description = "A personal site for projects, writing, and photography.",
} = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Alegreya:wght@400;500;600;700&family=Chicle&display=swap" rel="stylesheet" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" sizes="any" />
    <link rel="icon" href={`${base}favicon-96.png`} type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} sizes="180x180" />
    <title>{title}</title>
  </head>
  <body>
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>
    <slot />
  </body>
</html>
